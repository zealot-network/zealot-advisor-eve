# Model routing through Vercel AI Gateway. Evals need a key on your machine.
AI_GATEWAY_API_KEY=
# Optional. Defaults to vmc/zealot-advisor.
ZEALOT_ADVISOR_MODEL=
# Postgres for session isolation and saved briefs. Required outside local dev.
DATABASE_URL=
# Where finished build briefs are posted.
SLACK_WEBHOOK_URL=
# Contact form mail.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_NOTIFY_EMAILS=
# Prospect research tools. Off unless set.
PROSPECT_RESEARCH=
# Operator-only web search. Off unless 1, true, or on.
ZEALOT_OPERATOR_WEB_SEARCH=
MCP_ALLOWED_ORIGINS=
# Optional comma-separated names the knowledge layer should never connect to Zealot.
UNAFFILIATED_NAMES=
